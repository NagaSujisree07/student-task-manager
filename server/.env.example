# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/student_task_manager
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/student_task_manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/student_task_manager

# Client URL for CORS origin allowance
CLIENT_URL=http://localhost:5173
